#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define MOUS 2
#define BUTN 3
#define MEDI 4
#define NUM  5
#define SYMB 6
#define FUN  7

#define _______ &none

#define MY_AGUI &mt LGUI   A
#define MY_SALT &mt LALT   S
#define MY_DSFT &mt LSHIFT D
#define MY_FCTL &mt LCTRL  F

#define MY_JCTL &mt RCTRL  J
#define MY_KSFT &mt RSHIFT K
#define MY_LALT &mt RALT   L
#define MY_CGUI &mt RGUI   SEMICOLON

#define TG_MEDI &lt MEDI ESCAPE 
#define TG_NAV  &lt NAV  SPACE 
#define TG_MOUS &lt MOUS TAB 

#define TG_SYMB &lt SYMB ENTER 
#define TG_NUM  &lt NUM  BACKSPACE
#define TG_FUN  &lt FUN  DELETE 

#define TG_BUTN &lt BUTN KC_Z   

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                _______  &kp   Q  &kp   W  &kp   E  &kp   R   &kp T        &kp Y   &kp   U  &kp     I  &kp   O  &kp    P  _______
                _______  MY_AGUI  MY_SALT  MY_DSFT  MY_FCTL   &kp G        &kp H   MY_JCTL    MY_KSFT  MY_LALT   MY_CGUI  _______
                _______  &kp   Z  &kp   X  &kp   C  &kp   V   &kp B        &kp N   &kp   M  &kp COMMA  &kp DOT  &kp FSLH  _______
                                           TG_MEDI  TG_NAV  TG_MOUS        TG_SYMB  TG_NUM     TG_FUN
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                _______   _______   _______     _______    _______  _______        &kp K_CUT  &kp K_COPY  &kp K_PASTE  &kp K_UNDO  _______  _______
                _______  &kp LGUI  &kp LALT  &kp LSHIFT  &kp LCTRL  _______        &kp  LEFT  &kp   DOWN  &kp      UP  &kp  RIGHT  _______  _______
                _______   _______   _______     _______    _______  _______        &kp HOME   &kp  PG_DN  &kp   PG_UP  &kp    END  &kp INS  _______
                                                _______    _______  _______        &kp  RET   &kp   BSPC  &kp    RALT
            >;
        };

        mous {
            display-name = "MOUS";
            bindings = <
                _______   _______   _______     _______    _______  _______        &kp      K_CUT  &kp     K_COPY  &kp  K_PASTE       &kp K_UNDO  _______  _______
                _______  &kp LGUI  &kp LALT  &kp LSHIFT  &kp LCTRL  _______        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  _______  _______
                _______   _______   _______     _______    _______  _______        &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &kp INS  _______
                                                _______    _______  _______        &mkp       MB2  &mkp       MB1  &mkp     MB3
            >;
        };

        butn {
            display-name = "BUTN";
            bindings = <
                _______   _______   _______     _______    _______  _______        &kp K_CUT  &kp K_COPY  &kp K_PASTE  &kp K_UNDO  _______  _______
                _______  &kp LGUI  &kp LALT  &kp LSHIFT  &kp LCTRL  _______        &kp  LEFT  &kp   DOWN  &kp      UP  &kp  RIGHT  _______  _______
                _______   _______   _______     _______    _______  _______        &kp HOME   &kp  PG_DN  &kp   PG_UP  &kp    END  &kp INS  _______
                                                _______    _______  _______        &kp  RET   &kp   BSPC  &kp    RALT
            >;
        };

        medi {
            display-name = "MEDI";
            bindings = <
                &bootloader   _______   _______     _______    _______  _______           _______       _______       _______       _______        _______      _______
                    _______  &kp LGUI  &kp LALT  &kp LSHIFT  &kp LCTRL  _______        &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                    _______   _______   _______     _______    _______  _______           _______       _______       _______       _______        _______      _______
                                                    _______    _______  _______           _______       _______       _______
            >;
        };

        num {
            display-name = "NUM";
            bindings = <
                _______  &kp  LBKT  &kp N7  &kp N8  &kp  N9  &kp  RBKT       _______    _______     _______   _______   _______  _______
                _______  &kp   SQT  &kp N4  &kp N5  &kp  N6  &kp EQUAL       _______  &kp RCTRL  &kp RSHIFT  &kp RALT  &kp RGUI  _______
                _______  &kp GRAVE  &kp N1  &kp N2  &kp  N3  &kp  BSLH       _______    _______     _______   _______   _______  _______
                                            &kp N0  &kp DOT  &kp MINUS       _______    _______     _______
            >;
        };

        symb {
            display-name = "SYMB";
            bindings = <
                _______  &kp  LBRC  &kp AMPS  &kp ASTRK  &kp  LPAR  &kp  RBRC       _______    _______     _______   _______   _______  _______
                _______  &kp   DQT  &kp DLLR  &kp PRCNT  &kp CARET  &kp  PLUS       _______  &kp RCTRL  &kp RSHIFT  &kp RALT  &kp RGUI  _______
                _______  &kp TILDE  &kp EXCL  &kp    AT  &kp  HASH  &kp  PIPE       _______    _______     _______   _______   _______  _______
                                              &kp  LPAR  &kp  RPAR  &kp UNDER       _______    _______     _______
            >;
        };

        fun {
            display-name = "FUN";
            bindings = <
                _______  &kp F12  &kp F7  &kp     F8  &kp    F9    _______       _______    _______     _______   _______   _______  &bootloader
                _______  &kp F11  &kp F4  &kp     F5  &kp    F6  &kp  RALT       _______  &kp RCTRL  &kp RSHIFT  &kp RALT  &kp RGUI  _______
                _______  &kp F10  &kp F1  &kp     F2  &kp    F3  &kp  RALT       _______    _______     _______   _______   _______  _______
                                          &kp ESCAPE  &kp SPACE  &kp   TAB       _______    _______     _______
            >;
        };
        extra_1 {
                status = "reserved";
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};